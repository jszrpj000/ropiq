# Ropiq local UI
ROPIQ_PORT=8787

# User-installed generation backend. Ropiq does not distribute or start it.
BACKEND_TYPE=comfyui
BACKEND_BASE_URL=http://127.0.0.1:8188
BACKEND_API_TOKEN=

# Model provider: openai-compatible, anthropic, or gemini.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_ANTHROPIC_VERSION=2023-06-01
