# Model provider: openai-compatible, anthropic, or gemini.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=true
LLM_ANTHROPIC_VERSION=2023-06-01
